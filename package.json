{
  "name": "10000",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "conductor:run": "docker compose -f docker-compose.conductor.yml up --build",
    "conductor:archive": "sh -c 'docker compose -f docker-compose.conductor.yml down --volumes --rmi local --remove-orphans || true; rm -rf node_modules server/node_modules dist server/dist'"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@mui-extra/icons": "^0.0.76",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@react-oauth/google": "^0.12.1",
    "color": "^4.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "react-swipeable-views": "^0.14.0",
    "react-transition-group": "^4.4.5",
    "recharts": "^2.12.7",
    "seedrandom": "^3.0.5"
  },
  "devDependencies": {
    "@types/color": "^3.0.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/react-swipeable-views": "^0.13.5",
    "@types/react-transition-group": "^4.4.10",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
